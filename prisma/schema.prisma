// Stars Gifts Bot — Prisma schema (uses "gifts" schema in shared Supabase DB)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.izxodeqeofxkyeluymvz:wp8dZOTICPfYBCBQ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
  schemas  = ["gifts"]
}

model User {
  id          String   @id @default(cuid())
  tgId        String   @unique
  username    String?
  firstName   String?
  lastName    String?
  isAdmin     Boolean  @default(false)
  balance     Int      @default(0)  // ⭐ звёзды на балансе
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentGifts     GiftLog[] @relation("GiftSender")
  receivedGifts GiftLog[] @relation("GiftRecipient")
  transactions  Transaction[]

  @@schema("gifts")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "give", "transfer_in", "transfer_out", "withdraw", "sendgift_cost"
  amount      Int      // может быть отрицательным
  balanceAfter Int
  note        String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [tgId], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@schema("gifts")
}

model AvailableGift {
  id              String   @id @default(cuid())
  giftId          String   @unique
  starCount       Int
  emoji           String   @default("🎁")
  fileId          String?
  isLimited       Boolean  @default(false)
  isSoldOut       Boolean  @default(false)
  remainingCount  Int?
  totalCount      Int?
  isActive        Boolean  @default(true)
  lastCheckedAt  DateTime @default(now())

  @@index([starCount])
  @@index([isActive])
  @@schema("gifts")
}

model GiftLog {
  id                String   @id @default(cuid())
  senderTgId        String
  recipientTgId     String
  recipientUsername String?
  amount            Int      // цена gift в звёздах
  giftId            String
  count             Int      // сколько отправлено
  successCount      Int      // успешно отправлено
  failedCount       Int      // не удалось
  status            String   @default("partial") // success, partial, failed
  note              String?
  createdAt         DateTime @default(now())

  sender            User     @relation("GiftSender", fields: [senderTgId], references: [tgId])
  recipient         User     @relation("GiftRecipient", fields: [recipientTgId], references: [tgId])

  @@index([senderTgId])
  @@index([recipientTgId])
  @@index([createdAt])
  @@schema("gifts")
}
